# Example environment variables for AniSkolar Backend
# COPY this file to .env and fill in real values (do NOT commit .env)

# MongoDB Atlas connection string (do not store credentials in repo)
MONGODB_URI=your_mongodb_connection_string

# Port the server listens on (default 5000)
PORT=5000

# Clerk keys (generate in Clerk dashboard). Keep SECRET_KEY private.
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# Comma-separated list of allowed frontend origins used by server-side origin checks
FRONTEND_ORIGINS=http://localhost:3000
