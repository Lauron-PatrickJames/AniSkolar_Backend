# Example environment variables for AniSkolar Backend
# COPY this file to .env and fill in real values (do NOT commit .env)

# MongoDB Atlas connection string (do not store credentials in repo)
MONGODB_URI=your_mongodb_connection_string
# Optional: another database on the same cluster (e.g. for testing).
# Leave empty to use the main one.
MONGODB_DB=

# Port the server listens on (default 5000)
PORT=5000

# Clerk keys (generate in Clerk dashboard). Keep SECRET_KEY private.
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# Comma-separated list of allowed frontend origins used by server-side origin checks
FRONTEND_ORIGINS=http://localhost:3000

# Facebook Page cross-posting for announcements (server-side only; never
# expose these to the frontend). See README "Facebook Page integration".
FB_PAGE_ID=your_page_id
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
FB_GRAPH_VERSION=v23.0

# Uploaded files (documents, announcement images) in Azure Blob Storage.
# Leave AZURE_STORAGE_CONNECTION_STRING empty to keep files in MongoDB
# (fine for local development). See README "File storage".
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=aniskolar-files

# Email alerts for new messages (Azure Communication Services Email; lands in
# Outlook). Leave empty to turn emails off. See utils/mailer.js.
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER=
# Where replies to AniSkolar emails go (e.g. the AdSO's mailbox at handover);
# empty = replies go to the sender address.
EMAIL_REPLY_TO=
# Signature under AniSkolar emails, lines separated by |, e.g.
# EMAIL_SIGNATURE=Juan Dela Cruz, MS|Scholarship Associate
EMAIL_SIGNATURE=
# Where the AdSO is emailed about new student messages.
ADSO_NOTIFY_EMAIL=scholarship@dlsud.edu.ph
# Link in the emails (the frontend address).
APP_URL=http://localhost:3000
# Announcement emails: BCC batches of 50 sent per minute (raise once the
# email service allows more).
ANNOUNCEMENT_EMAIL_BATCHES_PER_MINUTE=2
# Reminders and summaries (Automation page): personal emails sent per
# minute from the outbox (the free Azure sender allows 10 an hour).
EMAIL_SENDS_PER_MINUTE=1
# Demos / testing only: let the SFAG be opened outside June and July.
# Leave empty (or remove) in production.
SFAG_OPEN_ALL_YEAR=
